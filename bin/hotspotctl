#!/usr/bin/python3
"""hotspotctl - privileged helper for Hotspot Manager.

Runs a Wi-Fi access point with hostapd, hands out addresses with dnsmasq and shares the
internet connection through NAT, and applies per-device / all-devices speed limits with tc.
The GUI calls it through pkexec; `status`, `interfaces` and `logs` also work as a normal user.
"""
import contextlib
import fcntl
import ipaddress
import json
import os
import re
import signal
import subprocess
import sys
import time

CONF_DIR = "/etc/hotspot-manager"
CONFIG = os.path.join(CONF_DIR, "config.json")
PASSWORD = os.path.join(CONF_DIR, "password")
BLOCKED = os.path.join(CONF_DIR, "blocked")
DEVICES = os.path.join(CONF_DIR, "devices.json")
LIMITS = os.path.join(CONF_DIR, "limits.json")
LOCK = os.path.join(CONF_DIR, ".lock")
DHCP_HOOK = "/usr/local/lib/hotspot-manager/dhcp-event"
IFB = "hm-ifb0"  # upload traffic is redirected here so it can be shaped like download
MAX_KBIT = 10_000_000
RUN = "/run/hotspot-manager"
HOSTAPD_CONF = os.path.join(RUN, "hostapd.conf")
CTRL = os.path.join(RUN, "ctrl")
LEASES = os.path.join(RUN, "dnsmasq.leases")
DNSMASQ_PID = os.path.join(RUN, "dnsmasq.pid")
STATE = os.path.join(RUN, "state.json")
SERVICE = "hotspot-manager.service"

# Non-DFS channels only: DFS needs radar detection, which most USB adapters can't do as an AP.
CHANNELS = {"5": [36, 40, 44, 48, 149, 153, 157, 161, 165], "2.4": list(range(1, 14))}
WIDTHS = {"5": [20, 40, 80], "2.4": [20, 40]}
DEFAULTS = {"interface": "", "ssid": "Hotspot", "band": "5", "channel": 36, "width": 80,
            "country": "", "hidden": False, "isolate": False, "max_clients": 0,
            # Addressing handed to devices. dns = [] means "ask the hotspot", which forwards to the laptop's DNS.
            "gateway": "10.42.0.1", "prefix": 24, "dhcp_start": "10.42.0.10", "dhcp_end": "10.42.0.254",
            "lease_hours": 12, "dns": []}
MAC_RE = re.compile(r"^[0-9a-f]{2}(:[0-9a-f]{2}){5}$")
IFACE_RE = re.compile(r"^[A-Za-z0-9_.-]{1,15}$")
FIREWALL = [("filter", "INPUT", "HM_INPUT"), ("filter", "FORWARD", "HM_FORWARD"),
            ("nat", "POSTROUTING", "HM_NAT")]


class Error(Exception):
    pass


def run(cmd, check=True, **kw):
    p = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if check and p.returncode != 0:
        raise Error(f"{' '.join(cmd)}: {(p.stderr or p.stdout).strip()}")
    return p


def quiet(cmd, **kw):
    return run(cmd, check=False, **kw)


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def write(path, text, mode=0o644):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)  # the O_CREAT mode is masked by umask
    os.replace(tmp, path)


def load_config():
    cfg = dict(DEFAULTS)
    try:
        cfg.update(json.loads(read(CONFIG) or "{}"))
    except ValueError:
        pass
    return cfg


def load_state():
    try:
        return json.loads(read(STATE) or "{}")
    except ValueError:
        return {}


def load_json(path, default):
    try:
        data = json.loads(read(path) or "null")
    except ValueError:
        data = None
    return data if isinstance(data, type(default)) else default


def load_devices():
    """Remembered devices: {mac: {"name", "hostname", "ip", "last_seen", "limit": {down, up}}}."""
    return {m: d for m, d in load_json(DEVICES, {}).items() if MAC_RE.match(m) and isinstance(d, dict)}


def load_limits():
    """{"default": per-device limit, "total": whole-hotspot limit}, each {down, up} in kbit/s (0 = none)."""
    raw = load_json(LIMITS, {})
    res = {}
    for key in ("default", "total"):
        pair = raw.get(key) if isinstance(raw.get(key), dict) else {}
        try:
            res[key] = speed_pair(pair, key, burst=key == "default")
        except Error:
            res[key] = {"down": 0, "up": 0}
    return res


def device_limit(dev, limits):
    """A device's own limit if it has one, else the all-devices limit."""
    return dev["limit"] if isinstance(dev.get("limit"), dict) else limits["default"]


def leases():
    res = {}
    for line in read(LEASES).splitlines():
        p = line.split()
        if len(p) >= 4 and MAC_RE.match(p[1].lower()):
            res[p[1].lower()] = {"ip": p[2], "hostname": "" if p[3] == "*" else p[3]}
    return res


@contextlib.contextmanager
def locked():
    """Serialise read-modify-write of the device files (the GUI and dnsmasq's hook both write them)."""
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(LOCK, "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def read_stdin_json():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        raise Error("expected a JSON object on stdin")
    return data


def blocked():
    return [l.strip().lower() for l in read(BLOCKED).splitlines() if MAC_RE.match(l.strip().lower())]


def service_state():
    return quiet(["systemctl", "is-active", SERVICE]).stdout.strip() or "unknown"


def need_root():
    if os.geteuid() != 0:
        raise Error("this command needs root (run it through pkexec or sudo)")


# ---- adapters ---------------------------------------------------------------------------

def uplinks():
    try:
        return {r.get("dev") for r in json.loads(quiet(["ip", "-j", "route", "show", "default"]).stdout or "[]")}
    except ValueError:
        return set()


def wireless_ifaces():
    up = uplinks()
    res = []
    for name in sorted(os.listdir("/sys/class/net")):
        phy = read(f"/sys/class/net/{name}/phy80211/name").strip()
        if not phy:
            continue
        info = quiet(["iw", "phy", phy, "info"]).stdout
        m = re.search(r"Supported interface modes:\n((?:\t\t \* .*\n)+)", info)
        dev = os.path.realpath(f"/sys/class/net/{name}/device")
        res.append({
            "name": name,
            "ap": bool(m) and any(l.strip() == "* AP" for l in m.group(1).splitlines()),
            "uplink": name in up,
            "usb": "/usb" in dev,
            "driver": os.path.basename(os.path.realpath(f"/sys/class/net/{name}/device/driver")),
            "bands": sorted({"2.4" if b == "1" else "5" for b in re.findall(r"^\tBand (\d+):", info, re.M) if b in "12"}),
        })
    return res


def pick_iface(cfg):
    want = cfg.get("interface") or ""
    ifs = wireless_ifaces()
    if want:
        if any(i["name"] == want for i in ifs):
            return want
        raise Error(f"Wi-Fi adapter {want} not found (unplugged?)")
    for i in ifs:
        if i["ap"] and not i["uplink"]:
            return i["name"]
    raise Error("no free Wi-Fi adapter that can run a hotspot")


def detect_country():
    for cc in re.findall(r"^country ([A-Z]{2}):", quiet(["iw", "reg", "get"]).stdout, re.M):
        if cc != "00":
            return cc
    return "US"


# ---- hostapd config ---------------------------------------------------------------------

def band_caps(phy, band):
    """Return the (HT, VHT) capability text of one band from `iw phy info`."""
    parts = re.split(r"\n\tBand (\d+):", quiet(["iw", "phy", phy, "info"]).stdout)
    want = "1" if band == "2.4" else "2"
    for num, text in zip(parts[1::2], parts[2::2]):
        if num == want:
            ht, _, vht = text.partition("VHT Capabilities")
            return ht, vht
    raise Error(f"this adapter does not support {band} GHz")


def hostapd_conf(cfg, iface, password):
    band, ch, width = cfg["band"], cfg["channel"], cfg["width"]
    if ch == 165:
        width = 20
    phy = read(f"/sys/class/net/{iface}/phy80211/name").strip()
    ht, vht = band_caps(phy, band)
    # Secondary 40 MHz channel above or below the primary one.
    plus = ch <= 7 if band == "2.4" else ((ch - (36 if ch < 149 else 149)) // 4) % 2 == 0
    htcap = ["[HT40+]" if plus else "[HT40-]"] if width >= 40 and "HT20/HT40" in ht else []
    htcap += [flag for needle, flag in (("RX LDPC", "[LDPC]"), ("RX HT20 SGI", "[SHORT-GI-20]"),
                                        ("RX HT40 SGI", "[SHORT-GI-40]"), ("TX STBC", "[TX-STBC]"),
                                        ("RX STBC 1-stream", "[RX-STBC1]")) if needle in ht]
    lines = [
        f"interface={iface}", "driver=nl80211", f"ctrl_interface={CTRL}", "ctrl_interface_group=0",
        f"ssid={cfg['ssid']}", "utf8_ssid=1", f"country_code={cfg['country']}", "ieee80211d=1",
        f"hw_mode={'a' if band == '5' else 'g'}", f"channel={ch}", "wmm_enabled=1",
        "ieee80211n=1", f"ht_capab={''.join(htcap)}",
    ]
    if band == "5" and vht:
        vcap = [flag for needle, flag in (("RX LDPC", "[RXLDPC]"), ("short GI (80 MHz)", "[SHORT-GI-80]"),
                                          ("TX STBC", "[TX-STBC-2BY1]"),
                                          ("Max MPDU length: 11454", "[MAX-MPDU-11454]"),
                                          ("Max MPDU length: 7991", "[MAX-MPDU-7991]")) if needle in vht]
        lines += ["ieee80211ac=1", f"vht_capab={''.join(vcap)}"]
        if width == 80:
            center = 42 if ch < 149 else 155
            lines += ["vht_oper_chwidth=1", f"vht_oper_centr_freq_seg0_idx={center}"]
        else:
            lines.append("vht_oper_chwidth=0")
    if cfg["hidden"]:
        lines.append("ignore_broadcast_ssid=1")
    if cfg["isolate"]:
        lines.append("ap_isolate=1")
    if cfg["max_clients"]:
        lines.append(f"max_num_sta={cfg['max_clients']}")
    lines += ["macaddr_acl=0", f"deny_mac_file={BLOCKED}", "auth_algs=1", "wpa=2",
              "wpa_key_mgmt=WPA-PSK", "rsn_pairwise=CCMP", f"wpa_passphrase={password}"]
    return "\n".join(lines) + "\n"


# ---- firewall / DHCP --------------------------------------------------------------------

def network(cfg):
    return ipaddress.IPv4Interface(f"{cfg['gateway']}/{cfg['prefix']}").network


def other_networks(iface=None):
    """IPv4 networks on the laptop's other interfaces (a hotspot subnet overlapping them breaks routing)."""
    try:
        addrs = json.loads(quiet(["ip", "-j", "-4", "addr", "show"]).stdout or "[]")
    except ValueError:
        return []
    return [(a["ifname"], ipaddress.IPv4Interface(f"{i['local']}/{i['prefixlen']}").network)
            for a in addrs if a.get("ifname") not in (iface, "lo") for i in a.get("addr_info", [])]


def firewall_down():
    for table, parent, chain in FIREWALL:
        while quiet(["iptables", "-t", table, "-D", parent, "-j", chain]).returncode == 0:
            pass
        quiet(["iptables", "-t", table, "-F", chain])
        quiet(["iptables", "-t", table, "-X", chain])


def firewall_up(iface, isolate, net):
    firewall_down()
    net = str(net)
    rules = {
        "HM_INPUT": [["-i", iface, "-p", "udp", "--dport", "67", "-j", "ACCEPT"],
                     ["-i", iface, "-p", "udp", "--dport", "53", "-j", "ACCEPT"],
                     ["-i", iface, "-p", "tcp", "--dport", "53", "-j", "ACCEPT"]],
        "HM_FORWARD": ([["-i", iface, "-o", iface, "-j", "DROP"]] if isolate else []) + [
                       ["-i", iface, "-s", net, "-j", "ACCEPT"],
                       ["-o", iface, "-d", net, "-m", "conntrack", "--ctstate", "RELATED,ESTABLISHED", "-j", "ACCEPT"]],
        "HM_NAT": [["-s", net, "!", "-o", iface, "-j", "MASQUERADE"]],
    }
    # Inserted at the top so they also win over ufw/firewalld's default-drop policies.
    for table, parent, chain in FIREWALL:
        run(["iptables", "-t", table, "-N", chain])
        for rule in rules[chain]:
            run(["iptables", "-t", table, "-A", chain] + rule)
        run(["iptables", "-t", table, "-I", parent, "1", "-j", chain])


def stop_dnsmasq(keep_leases=False):
    pid = read(DNSMASQ_PID).strip()
    if pid.isdigit() and read(f"/proc/{pid}/comm").strip() == "dnsmasq":
        os.kill(int(pid), signal.SIGTERM)
        for _ in range(20):  # wait so a restart can bind the same address
            if not os.path.exists(f"/proc/{pid}"):
                break
            time.sleep(0.1)
    for f in [DNSMASQ_PID] + ([] if keep_leases else [LEASES]):
        if os.path.exists(f):
            os.remove(f)


def start_dnsmasq(iface, keep_leases=False):
    cfg = load_config()
    net, gw = network(cfg), cfg["gateway"]
    stop_dnsmasq(keep_leases)
    fixed = [f"--dhcp-host={mac},{d['static_ip']}" for mac, d in load_devices().items()
             if d.get("static_ip") and ipaddress.IPv4Address(d["static_ip"]) in net]  # skip ones left from an old subnet
    run(["dnsmasq", "--conf-file=/dev/null", "--no-hosts", f"--interface={iface}", "--bind-dynamic",
         f"--listen-address={gw}",
         f"--dhcp-range={cfg['dhcp_start']},{cfg['dhcp_end']},{net.netmask},{cfg['lease_hours']}h",
         f"--dhcp-option=option:router,{gw}", f"--dhcp-option=option:dns-server,{','.join(cfg['dns']) or gw}",
         "--dhcp-authoritative", f"--dhcp-leasefile={LEASES}", f"--pid-file={DNSMASQ_PID}",
         f"--dhcp-script={DHCP_HOOK}"] + fixed)


def set_ip_forward(value):
    with open("/proc/sys/net/ipv4/ip_forward", "w") as f:
        f.write(value)


# ---- speed limits ------------------------------------------------------------------------

def shaping_down(iface):
    quiet(["tc", "qdisc", "del", "dev", iface, "root"])
    quiet(["tc", "qdisc", "del", "dev", iface, "ingress"])
    quiet(["ip", "link", "del", IFB])


def htb(dev, total, items, match):
    """Shape traffic leaving dev: an optional total cap, plus one capped class per
    (ip, kbit, peak_kbit, burst_secs) item. Everything else goes to the default class 1:ffff,
    limited only by the total."""
    top = total or MAX_KBIT
    tc = lambda *a: run(["tc", *a])

    def htb_class(parent, cid, kbit):
        # tc's default burst (~1600 bytes) is too small to reach high rates; allow ~5 ms of traffic.
        burst = str(max(3200, kbit * 5 // 8))
        tc("class", "add", "dev", dev, "parent", parent, "classid", cid, "htb", "rate", f"{kbit}kbit",
           "ceil", f"{kbit}kbit", "burst", burst, "cburst", burst,
           "quantum", str(max(1514, min(60000, kbit * 125 // 10))))

    tc("qdisc", "add", "dev", dev, "root", "handle", "1:", "htb", "default", "ffff")
    htb_class("1:", "1:1", top)
    htb_class("1:1", "1:ffff", top)
    tc("qdisc", "add", "dev", dev, "parent", "1:ffff", "fq_codel")
    for n, (ip, kbit, peak, secs) in enumerate(items, start=2):
        cid = f"1:{n:x}"
        if peak > kbit:
            # Burst: a token bucket filling at kbit, sized so the device can run at the peak for
            # `secs` seconds before dropping back to kbit; it refills while the device uses less.
            htb_class("1:1", cid, min(peak, top))
            bucket = max(3200, (peak - kbit) * 125 * secs)
            tc("qdisc", "add", "dev", dev, "parent", cid, "tbf", "rate", f"{kbit}kbit", "burst", str(bucket),
               "peakrate", f"{peak}kbit", "mtu", "1600", "latency", "200ms")
        else:
            htb_class("1:1", cid, min(kbit, top))
            tc("qdisc", "add", "dev", dev, "parent", cid, "fq_codel")
        tc("filter", "add", "dev", dev, "parent", "1:", "protocol", "ip", "prio", "1",
           "flower", match, ip, "classid", cid)


def apply_shaping(changed=None):
    """Rebuild the tc setup from the saved limits for every device that has a DHCP lease.
    changed=(event, mac, ip) covers a lease dnsmasq is reporting but may not have written yet."""
    iface = load_state().get("interface")
    if not iface:
        return
    limits, devices, active = load_limits(), load_devices(), {m: l["ip"] for m, l in leases().items()}
    if changed:
        event, mac, ip = changed
        if event == "del":
            active.pop(mac, None)
        else:
            active[mac] = ip
    down, up = [], []
    for mac, ip in sorted(active.items(), key=lambda kv: kv[1]):
        lim = device_limit(devices.get(mac, {}), limits)
        if lim["down"]:
            down.append((ip, lim["down"], lim.get("burst_down", 0), lim.get("burst_secs", 0)))
        if lim["up"]:
            up.append((ip, lim["up"], lim.get("burst_up", 0), lim.get("burst_secs", 0)))
    shaping_down(iface)
    # Download = traffic the laptop sends out of the hotspot adapter.
    if down or limits["total"]["down"]:
        htb(iface, limits["total"]["down"], down, "dst_ip")
    # Upload arrives on the adapter; redirect it through an IFB device so it can be queued too.
    if up or limits["total"]["up"]:
        run(["ip", "link", "add", IFB, "type", "ifb"])
        run(["ip", "link", "set", IFB, "up"])
        run(["tc", "qdisc", "add", "dev", iface, "handle", "ffff:", "ingress"])
        run(["tc", "filter", "add", "dev", iface, "parent", "ffff:", "protocol", "all", "matchall",
             "action", "mirred", "egress", "redirect", "dev", IFB])
        htb(IFB, limits["total"]["up"], up, "src_ip")


def lease_event(args):
    """dnsmasq --dhcp-script hook: remember the device and re-apply speed limits."""
    if len(args) < 3 or args[0] not in ("add", "old", "del") or not MAC_RE.match(args[1].lower()):
        return
    event, mac, ip = args[0], args[1].lower(), args[2]
    hostname = "".join(c for c in (args[3] if len(args) > 3 else "") if c.isprintable())[:63]
    with locked():
        devices = load_devices()
        dev = devices.setdefault(mac, {})
        if event != "del":
            dev.update(ip=ip, last_seen=int(time.time()))
            if hostname:
                dev["hostname"] = hostname
        write(DEVICES, json.dumps(devices, indent=1) + "\n")
        apply_shaping((event, mac, ip))


# ---- service hooks (run by systemd) -----------------------------------------------------

def pre_start():
    """ExecStartPre: write hostapd.conf and set up addressing and NAT."""
    cfg = load_config()
    password = read(PASSWORD).strip()
    if not password:
        raise Error("no password set")
    for attempt in range(20):  # at boot a USB adapter can show up a few seconds late
        try:
            iface = pick_iface(cfg)
            break
        except Error:
            if attempt == 19:
                raise
            time.sleep(1)
    cfg["country"] = cfg["country"] or detect_country()
    os.makedirs(RUN, exist_ok=True)
    os.chmod(RUN, 0o755)
    if not os.path.exists(BLOCKED):
        write(BLOCKED, "")
    write(HOSTAPD_CONF, hostapd_conf(cfg, iface, password), 0o600)
    write(STATE, json.dumps({"interface": iface,
                             "ip_forward": read("/proc/sys/net/ipv4/ip_forward").strip()}))
    quiet(["nmcli", "device", "set", iface, "managed", "no"])
    quiet(["rfkill", "unblock", "wifi"])
    quiet(["iw", "reg", "set", cfg["country"]])
    time.sleep(1)  # let NetworkManager/wpa_supplicant let go of the adapter
    run(["ip", "addr", "flush", "dev", iface])
    clash = [name for name, net in other_networks(iface) if net.overlaps(network(cfg))]
    if clash:
        raise Error(f"the hotspot network {network(cfg)} overlaps {clash[0]}'s network; pick another hotspot IP")
    run(["ip", "addr", "add", f"{cfg['gateway']}/{cfg['prefix']}", "dev", iface])
    run(["ip", "link", "set", iface, "up"])
    set_ip_forward("1")
    firewall_up(iface, cfg["isolate"], network(cfg))


def post_start():
    """ExecStartPost: start DHCP/DNS (here, not in _pre, so systemd doesn't see a stray process)."""
    start_dnsmasq(load_state()["interface"])
    with locked():
        apply_shaping()


def post_stop():
    """ExecStopPost: undo everything pre_start did."""
    st = load_state()
    stop_dnsmasq()
    firewall_down()
    iface = st.get("interface")
    if iface:
        shaping_down(iface)
        quiet(["ip", "addr", "flush", "dev", iface])
        quiet(["nmcli", "device", "set", iface, "managed", "yes"])
    if st.get("ip_forward") == "0":
        set_ip_forward("0")
    for f in (HOSTAPD_CONF, STATE):
        if os.path.exists(f):
            os.remove(f)


# ---- commands ---------------------------------------------------------------------------

def last_error():
    lines = quiet(["journalctl", "-u", SERVICE, "-n", "40", "-o", "cat", "--no-pager"]).stdout.splitlines()
    bad = [l for l in lines if re.search(r"error|fail|could not|not found|invalid|hotspotctl:", l, re.I)]
    return (bad or lines or ["unknown error"])[-1].strip()


def hostapd_cli(*args):
    iface = load_state().get("interface")
    if not iface:
        raise Error("hotspot is not running")
    return quiet(["hostapd_cli", "-p", CTRL, "-i", iface] + list(args))


def cmd_start():
    need_root()
    run(["systemctl", "start", SERVICE])
    for _ in range(30):  # hostapd keeps setting up after systemd considers it started
        time.sleep(0.5)
        state = service_state()
        if state == "failed":
            raise Error(last_error())
        if state == "active" and "state=ENABLED" in hostapd_cli("status").stdout:
            return
    raise Error("hotspot did not come up in time: " + last_error())


def cmd_stop():
    need_root()
    run(["systemctl", "stop", SERVICE])


def cmd_restart():
    need_root()
    quiet(["systemctl", "stop", SERVICE])
    cmd_start()


def validate(cfg):
    ssid = cfg["ssid"]
    if not isinstance(ssid, str) or not 1 <= len(ssid.encode()) <= 32 or any(ord(c) < 32 or ord(c) == 127 for c in ssid):
        raise Error("network name must be 1-32 bytes with no control characters")
    if cfg["band"] not in CHANNELS:
        raise Error("band must be 5 or 2.4")
    if type(cfg["channel"]) is not int or cfg["channel"] not in CHANNELS[cfg["band"]]:
        raise Error(f"channel must be one of {CHANNELS[cfg['band']]}")
    if type(cfg["width"]) is not int or cfg["width"] not in WIDTHS[cfg["band"]]:
        raise Error(f"channel width must be one of {WIDTHS[cfg['band']]}")
    if not isinstance(cfg["country"], str) or (cfg["country"] and (not re.fullmatch(r"[A-Z]{2}", cfg["country"]) or cfg["country"] == "00")):
        raise Error("country must be a two-letter code like US or DE")
    if not isinstance(cfg["interface"], str) or (cfg["interface"] and not IFACE_RE.match(cfg["interface"])):
        raise Error("invalid adapter name")
    for key in ("hidden", "isolate"):
        if not isinstance(cfg[key], bool):
            raise Error(f"{key} must be true or false")
    if type(cfg["max_clients"]) is not int or not 0 <= cfg["max_clients"] <= 255:
        raise Error("max_clients must be 0-255")
    validate_network(cfg)


def ip_arg(value, what):
    try:
        return ipaddress.IPv4Address(value if isinstance(value, str) else "")
    except ValueError:
        raise Error(f"{what} must be an IPv4 address like 192.168.50.1")


def validate_network(cfg):
    if type(cfg["prefix"]) is not int or not 16 <= cfg["prefix"] <= 29:
        raise Error("subnet mask must be between /16 (255.255.0.0) and /29 (255.255.255.248)")
    gw = ip_arg(cfg["gateway"], "hotspot IP")
    if not gw.is_private:
        raise Error("hotspot IP must be a private address (10.x, 172.16-31.x or 192.168.x)")
    net = network(cfg)
    if gw in (net.network_address, net.broadcast_address):
        raise Error(f"{gw} is the network/broadcast address of {net}; use e.g. {net.network_address + 1}")
    start, end = ip_arg(cfg["dhcp_start"], "DHCP range start"), ip_arg(cfg["dhcp_end"], "DHCP range end")
    hosts = (net.network_address + 1, net.broadcast_address - 1)
    if not (start in net and end in net):
        raise Error(f"the DHCP range must be inside {net} ({hosts[0]} - {hosts[1]})")
    if start > end:
        raise Error("the DHCP range start must not be after its end")
    if start in (net.network_address, net.broadcast_address) or end in (net.network_address, net.broadcast_address):
        raise Error(f"the DHCP range must stay within {hosts[0]} - {hosts[1]}")
    if start <= gw <= end:
        raise Error(f"the hotspot IP {gw} must be outside the DHCP range")
    if type(cfg["lease_hours"]) is not int or not 1 <= cfg["lease_hours"] <= 720:
        raise Error("lease time must be 1-720 hours")
    if not isinstance(cfg["dns"], list) or len(cfg["dns"]) > 3:
        raise Error("give up to 3 DNS servers")
    cfg["dns"] = [str(ip_arg(d, "DNS server")) for d in cfg["dns"]]
    clash = [name for name, other in other_networks(load_state().get("interface") or cfg["interface"]) if other.overlaps(net)]
    if clash:
        raise Error(f"{net} overlaps the network on {clash[0]}; pick a different hotspot IP")


def cmd_set_config():
    """Read a JSON object from stdin: any config keys, plus optional "password" and "boot"."""
    need_root()
    data = read_stdin_json()
    cfg = load_config()
    cfg.update({k: data[k] for k in DEFAULTS if k in data})
    validate(cfg)
    password = data.get("password")
    if password:
        if not isinstance(password, str) or not 8 <= len(password) <= 63 or any(not 32 <= ord(c) <= 126 for c in password):
            raise Error("password must be 8-63 plain characters (letters, digits, symbols)")
    elif not read(PASSWORD).strip():
        raise Error("set a password")
    os.makedirs(CONF_DIR, exist_ok=True)
    write(CONFIG, json.dumps({k: cfg[k] for k in DEFAULTS}, indent=2) + "\n")
    if password:
        write(PASSWORD, password + "\n", 0o600)
    if "boot" in data:
        run(["systemctl", "enable" if data["boot"] else "disable", SERVICE])
    if service_state() in ("active", "activating"):
        cmd_restart()


def speed_pair(value, what, burst=True):
    """Validate {down, up} (+ optional burst_down, burst_up = peak kbit/s, burst_secs)."""
    if not isinstance(value, dict):
        raise Error(f"{what} must be an object with down and up")

    def num(key, hi):
        v = value.get(key, 0)
        if type(v) is not int or not 0 <= v <= hi:
            raise Error(f"{what} {key} must be a whole number from 0 to {hi}")
        return v

    res = {d: num(d, MAX_KBIT) for d in ("down", "up")}
    if burst:
        for d in ("down", "up"):
            peak = num(f"burst_{d}", MAX_KBIT)
            if peak and res[d] and peak <= res[d]:
                raise Error(f"{what}: the {d}load burst speed must be higher than the limit")
            res[f"burst_{d}"] = peak if res[d] else 0  # no limit = nothing to burst above
        res["burst_secs"] = num("burst_secs", 60)
        if (res["burst_down"] or res["burst_up"]) and not res["burst_secs"]:
            raise Error(f"{what}: set how many seconds a burst may last (1-60)")
        if not (res["burst_down"] or res["burst_up"]):
            del res["burst_down"], res["burst_up"], res["burst_secs"]
    return res


def static_ip(value, mac, devices):
    cfg = load_config()
    ip, net = ip_arg(value, "fixed IP"), network(cfg)
    if ip not in net or ip in (net.network_address, net.broadcast_address):
        raise Error(f"the fixed IP must be inside the hotspot network {net}")
    if str(ip) == cfg["gateway"]:
        raise Error(f"{ip} is the hotspot's own address")
    taken = [m for m, d in devices.items() if m != mac and d.get("static_ip") == str(ip)]
    if taken:
        raise Error(f"{ip} is already reserved for {devices[taken[0]].get('name') or taken[0]}")
    return str(ip)


def cmd_set_devices():
    """Read JSON from stdin, speeds in kbit/s (0 = no limit):
    {"default"?: {down, up, burst_down?, burst_up?, burst_secs?}, "total"?: {down, up},
     "devices"?: {mac: null (forget it) | {"name"?: str, "limit"?: {down, up} | null (use default),
                                             "static_ip"?: "10.42.0.50" | "" (automatic)}}}"""
    need_root()
    data = read_stdin_json()
    changes = data.get("devices") or {}
    if not isinstance(changes, dict):
        raise Error("devices must be an object keyed by MAC address")
    moved = []  # devices whose fixed IP changed
    with locked():
        limits, devices = load_limits(), load_devices()
        for key in ("default", "total"):
            if key in data:
                limits[key] = speed_pair(data[key], key, burst=key == "default")
        for mac, change in changes.items():
            mac = mac.lower()
            if not MAC_RE.match(mac):
                raise Error(f"bad MAC address {mac!r}")
            if change is None:
                devices.pop(mac, None)
                continue
            if not isinstance(change, dict):
                raise Error("each device change must be an object or null")
            dev = devices.setdefault(mac, {})
            if "name" in change:
                name = change["name"]
                if not isinstance(name, str) or len(name) > 40 or not name.isprintable():
                    raise Error("device names must be up to 40 printable characters")
                if name.strip():
                    dev["name"] = name.strip()
                else:
                    dev.pop("name", None)
            if "limit" in change:
                if change["limit"] is None:
                    dev.pop("limit", None)
                else:
                    dev["limit"] = speed_pair(change["limit"], "limit")
            if "static_ip" in change and change["static_ip"] != dev.get("static_ip", ""):
                if change["static_ip"]:
                    dev["static_ip"] = static_ip(change["static_ip"], mac, devices)
                else:
                    dev.pop("static_ip", None)
                moved.append(mac)
        write(LIMITS, json.dumps(limits, indent=1) + "\n")
        write(DEVICES, json.dumps(devices, indent=1) + "\n")
        if service_state() == "active":
            if moved:
                # dnsmasq reads fixed addresses at start. Reconnect the device so it picks up its new IP.
                start_dnsmasq(load_state()["interface"], keep_leases=True)
                for mac in moved:
                    hostapd_cli("deauthenticate", mac)
            apply_shaping()


def cmd_get_password():
    need_root()
    print(read(PASSWORD).strip())


def mac_arg(args):
    if len(args) != 1 or not MAC_RE.match(args[0].lower()):
        raise Error("expected one MAC address like aa:bb:cc:dd:ee:ff")
    return args[0].lower()


def cmd_kick(args):
    need_root()
    hostapd_cli("deauthenticate", mac_arg(args))


def cmd_block(args):
    need_root()
    mac = mac_arg(args)
    macs = blocked()
    if mac not in macs:
        write(BLOCKED, "\n".join(macs + [mac]) + "\n")
    if service_state() == "active":
        hostapd_cli("deny_acl", "ADD_MAC", mac)
        hostapd_cli("deauthenticate", mac)


def cmd_unblock(args):
    need_root()
    mac = mac_arg(args)
    macs = [m for m in blocked() if m != mac]
    write(BLOCKED, "\n".join(macs) + ("\n" if macs else ""))
    if service_state() == "active":
        hostapd_cli("deny_acl", "DEL_MAC", mac)


def cmd_status():
    cfg = load_config()
    state = service_state()
    iface = load_state().get("interface", "")
    link, online = {}, {}
    if state == "active" and iface:
        m = re.search(r"channel (\d+) \((\d+) MHz\), width: (\d+) MHz", quiet(["iw", "dev", iface, "info"]).stdout)
        if m:
            link = {"channel": int(m[1]), "freq": int(m[2]), "width": int(m[3])}
        dump = quiet(["iw", "dev", iface, "station", "dump"]).stdout
        for block in re.split(r"^Station ", dump, flags=re.M)[1:]:
            mac = block.split()[0].lower()
            f = dict(re.findall(r"^\s+([^:\n]+):\s+(.*)$", block, re.M))
            first = lambda key: (f.get(key) or "").split(" ")[0]
            online[mac] = {"signal": first("signal"), "down_rate": first("tx bitrate"),
                            "up_rate": first("rx bitrate"), "down_bytes": int(first("tx bytes") or 0),
                            "up_bytes": int(first("rx bytes") or 0),
                            "connected": int(first("connected time") or 0)}
    known, limits, lease, blocked_macs = load_devices(), load_limits(), leases(), blocked()
    now = int(time.time())
    devices = []
    for mac in sorted(set(known) | set(online) | set(blocked_macs)):
        dev, live, ls = known.get(mac, {}), online.get(mac), lease.get(mac, {})
        devices.append({
            "mac": mac, "name": dev.get("name", ""), "hostname": ls.get("hostname") or dev.get("hostname", ""),
            "ip": ls.get("ip") or dev.get("ip", ""), "online": live is not None, "blocked": mac in blocked_macs,
            "last_seen": now if live else dev.get("last_seen", 0),
            "limit": dev.get("limit"), "effective": device_limit(dev, limits), "static_ip": dev.get("static_ip", ""),
            **(live or {}),
        })
    print(json.dumps({
        "state": state,
        "boot": quiet(["systemctl", "is-enabled", SERVICE]).stdout.strip() == "enabled",
        "config": cfg, "interface": iface, "link": link, "devices": devices, "limits": limits,
        "blocked": blocked_macs,
        "error": last_error() if state == "failed" else "",
    }))


def cmd_logs():
    print(quiet(["journalctl", "-u", SERVICE, "-n", "100", "-o", "short", "--no-pager"]).stdout)


COMMANDS = {
    "start": cmd_start, "stop": cmd_stop, "restart": cmd_restart, "status": cmd_status,
    "interfaces": lambda: print(json.dumps(wireless_ifaces())), "logs": cmd_logs,
    "set-config": cmd_set_config, "set-devices": cmd_set_devices, "get-password": cmd_get_password,
    "_pre": lambda: (need_root(), pre_start()), "_started": lambda: (need_root(), post_start()),
    "_post": lambda: (need_root(), post_stop()),
}
MAC_COMMANDS = {"kick": cmd_kick, "block": cmd_block, "unblock": cmd_unblock,
                "_lease": lambda args: (need_root(), lease_event(args))}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in {**COMMANDS, **MAC_COMMANDS}:
        print("usage: hotspotctl start|stop|restart|status|interfaces|logs|set-config|set-devices|"
              "get-password|kick MAC|block MAC|unblock MAC", file=sys.stderr)
        sys.exit(2)
    cmd = sys.argv[1]
    try:
        if cmd in MAC_COMMANDS:
            MAC_COMMANDS[cmd](sys.argv[2:])
        else:
            COMMANDS[cmd]()
    except Error as e:
        print(f"hotspotctl: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
