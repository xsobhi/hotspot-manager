#!/usr/bin/python3
"""Hotspot Manager - control a hostapd Wi-Fi hotspot from the desktop."""
import ipaddress
import json
import secrets
import shutil
import string
import subprocess
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, GLib, Gtk  # noqa: E402

HELPER = "/usr/local/bin/hotspotctl"
CHANNELS = {"5": [36, 40, 44, 48, 149, 153, 157, 161, 165], "2.4": list(range(1, 14))}
WIDTHS = {"5": [20, 40, 80], "2.4": [20, 40]}
OUI_FILE = "/usr/share/ieee-data/oui.txt"
LEASE_TIMES = [(1, "1 hour"), (6, "6 hours"), (12, "12 hours"), (24, "1 day"), (72, "3 days"), (168, "1 week")]
SPEED_PRESETS = [1000, 2000, 3000, 5000, 10000, 20000, 50000]  # kbit/s, same down and up
# Device list columns
C_MAC, C_STATUS, C_NAME, C_SORT_NAME, C_NOW, C_NOW_SORT, C_LIMIT, C_DATA, C_DATA_SORT, C_SEARCH, C_ONLINE, C_BLOCKED = range(12)
STATE_TEXT = {"active": "On", "activating": "Starting…", "deactivating": "Stopping…",
              "inactive": "Off", "failed": "Failed"}


def helper(*args, root=False, data=None):
    cmd = (["pkexec", HELPER] if root else [HELPER]) + list(args)
    p = subprocess.run(cmd, input=data, capture_output=True, text=True)
    if p.returncode != 0:
        msg = (p.stderr or p.stdout).strip() or f"{args[0]} failed"
        raise RuntimeError(msg.removeprefix("hotspotctl: "))
    return p.stdout


def in_thread(work, done):
    """Run work() off the UI thread, then done(result, error) back on it."""
    def target():
        try:
            res, err = work(), None
        except Exception as e:  # shown to the user in the info bar
            res, err = None, str(e)
        GLib.idle_add(lambda: done(res, err) and False)
    threading.Thread(target=target, daemon=True).start()


def human_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def human_time(s):
    h, m = divmod(s // 60, 60)
    return f"{h}h {m}m" if h else f"{m}m {s % 60}s"


def ago(ts):
    if not ts:
        return "never"
    s = max(0, int(time.time()) - ts)
    for unit, n in (("day", 86400), ("h", 3600), ("min", 60)):
        if s >= n:
            v = s // n
            return f"{v} {unit}{'s' if unit == 'day' and v > 1 else ''} ago"
    return "just now"


def fmt_rate(bits_per_sec):
    if bits_per_sec < 1000:
        return "0"
    if bits_per_sec < 1_000_000:
        return f"{bits_per_sec / 1000:.0f} kbps"
    return f"{bits_per_sec / 1_000_000:.1f} Mbps"


def fmt_limit(kbit):
    if not kbit:
        return "no limit"
    return f"{kbit} kbps" if kbit < 1000 else f"{kbit / 1000:g} Mbps"


def fmt_speed(limit):
    """Short text for a limit: "2 Mbps", "↓ 5 Mbps  ↑ 1 Mbps", "No limit"."""
    if not limit["down"] and not limit["up"]:
        return "No limit"
    text = fmt_limit(limit["down"]) if limit["down"] == limit["up"] else \
        f"↓ {fmt_limit(limit['down'])}  ↑ {fmt_limit(limit['up'])}"
    if limit.get("burst_down") or limit.get("burst_up"):
        text += " + bursts"
    return text


def preset_id(limit):
    """The speed dropdown entry matching a limit, or "custom"."""
    if limit is None:
        return "default"
    if limit.get("burst_down") or limit.get("burst_up"):
        return "custom"
    if not limit["down"] and not limit["up"]:
        return "0"
    if limit["down"] == limit["up"] and limit["down"] in SPEED_PRESETS:
        return str(limit["down"])
    return "custom"


_vendors = None


def vendor(mac):
    """Manufacturer from the MAC prefix; phones often use a random ("private") address instead."""
    global _vendors
    if int(mac[1], 16) & 2:
        return ""
    if _vendors is None:
        _vendors = {}
        try:
            with open(OUI_FILE, encoding="utf-8", errors="replace") as f:
                for line in f:
                    if "(hex)" in line:
                        prefix, _, name = line.partition("(hex)")
                        _vendors[prefix.strip().replace("-", ":").lower()] = name.strip()
        except OSError:
            pass
    return _vendors.get(mac[:8], "")


def device_name(d):
    return d["name"] or d["hostname"] or vendor(d["mac"]) or "Unknown device"


def speed_spin(kbit):
    spin = Gtk.SpinButton.new_with_range(0, 1000, 0.5)
    spin.set_digits(1)
    spin.set_value(kbit / 1000)
    return spin


def spin_kbit(spin):
    return int(round(spin.get_value() * 1000))


def form(rows, margin=0):
    """rows: (label, widget) pairs as a two-column form; a None label makes a full-width row."""
    grid = Gtk.Grid(column_spacing=12, row_spacing=10, margin=margin)
    for n, (label, widget) in enumerate(rows):
        if label is None:
            grid.attach(widget, 0, n, 2, 1)
            continue
        grid.attach(Gtk.Label(label=label, xalign=1), 0, n, 1, 1)
        widget.set_hexpand(True)
        grid.attach(widget, 1, n, 1, 1)
    return grid


def heading(text, sub=None):
    markup = f"<b>{GLib.markup_escape_text(text)}</b>"
    if sub:
        markup += f"\n<small>{GLib.markup_escape_text(sub)}</small>"
    return Gtk.Label(label=markup, use_markup=True, xalign=0, wrap=True)


class LimitEditor(Gtk.Box):
    """Download/upload limit in Mbps, optionally with short bursts above it."""

    def __init__(self, limit, burst=True):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.down, self.up = speed_spin(limit["down"]), speed_spin(limit["up"])
        row = Gtk.Box(spacing=6)
        for label, spin in (("Download", self.down), ("Upload", self.up)):
            row.pack_start(Gtk.Label(label=label), False, False, 0)
            row.pack_start(spin, False, False, 0)
        row.pack_start(Gtk.Label(label="Mbps  (0 = no limit)"), False, False, 0)
        self.add(row)
        self.burst = None
        if not burst:
            return
        on = bool(limit.get("burst_down") or limit.get("burst_up"))
        self.burst = Gtk.CheckButton(label="Allow short bursts (pages load fast, then back to the limit)", active=on)
        self.add(self.burst)
        self.burst_down = speed_spin(limit.get("burst_down") or limit["down"] * 2)
        self.burst_up = speed_spin(limit.get("burst_up") or limit["up"] * 2)
        self.secs = Gtk.SpinButton.new_with_range(1, 60, 1)
        self.secs.set_value(limit.get("burst_secs") or 2)
        burst_row = Gtk.Box(spacing=6, margin_start=24, sensitive=on)
        for widget in (Gtk.Label(label="Up to ↓"), self.burst_down, Gtk.Label(label="↑"), self.burst_up,
                       Gtk.Label(label="Mbps for"), self.secs, Gtk.Label(label="seconds")):
            burst_row.pack_start(widget, False, False, 0)
        self.burst.connect("toggled", lambda b: burst_row.set_sensitive(b.get_active()))
        self.add(burst_row)

    def get(self):
        res = {"down": spin_kbit(self.down), "up": spin_kbit(self.up)}
        if self.burst and self.burst.get_active():
            res.update(burst_down=spin_kbit(self.burst_down) if res["down"] else 0,
                       burst_up=spin_kbit(self.burst_up) if res["up"] else 0,
                       burst_secs=int(self.secs.get_value()))
        return res


def speed_combo(everyone=None):
    """Dropdown of speeds. With everyone (the shared limit) it starts with "Same as everyone"."""
    combo = Gtk.ComboBoxText()
    if everyone is not None:
        combo.append("default", f"Same as everyone ({fmt_speed(everyone)})")
    combo.append("0", "No limit")
    for kbit in SPEED_PRESETS:
        combo.append(str(kbit), fmt_limit(kbit))
    combo.append("custom", "Custom…")
    return combo


def wifi_qr_text(ssid, password, hidden):
    esc = lambda s: "".join("\\" + c if c in '\\;,":' else c for c in s)
    return f"WIFI:T:WPA;S:{esc(ssid)};P:{esc(password)};{'H:true;' if hidden else ''};"


class HotspotWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Hotspot Manager")
        self.set_default_size(720, 560)
        self.set_icon_name("hotspot-manager")
        self.status = {}
        self.password = None
        self.settings_loaded = False
        self.busy = False
        self.polling = False
        self.device_info = {}
        self.prev_bytes = {}

        header = Gtk.HeaderBar(show_close_button=True, title="Hotspot Manager")
        self.set_titlebar(header)
        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER, tooltip_text="Turn the hotspot on or off")
        self.switch_handler = self.switch.connect("notify::active", self.on_switch)
        header.pack_end(self.switch)
        share = Gtk.Button(tooltip_text="Show a QR code to join the hotspot")
        share_box = Gtk.Box(spacing=6)
        share_box.add(Gtk.Image.new_from_icon_name("hotspot-manager-qr", Gtk.IconSize.BUTTON))
        share_box.add(Gtk.Label(label="QR code"))
        share.add(share_box)
        share.connect("clicked", self.on_share)
        header.pack_start(share)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(box)
        self.infobar = Gtk.InfoBar(show_close_button=True, revealed=False)
        self.info_label = Gtk.Label(wrap=True, xalign=0)
        self.infobar.get_content_area().add(self.info_label)
        self.infobar.connect("response", lambda bar, _r: bar.set_revealed(False))
        box.pack_start(self.infobar, False, False, 0)

        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=16, margin_bottom=8)
        self.state_label = Gtk.Label(xalign=0)
        self.summary_label = Gtk.Label(xalign=0, wrap=True)
        self.summary_label.get_style_context().add_class("dim-label")
        top.add(self.state_label)
        top.add(self.summary_label)
        box.pack_start(top, False, False, 0)

        stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        box.pack_start(Gtk.StackSwitcher(stack=stack, halign=Gtk.Align.CENTER), False, False, 0)
        box.pack_start(stack, True, True, 0)
        stack.add_titled(self.build_devices(), "devices", "Devices")
        stack.add_titled(self.build_settings(), "settings", "Settings")

        self.set_state_text("Loading…", "")
        in_thread(lambda: json.loads(helper("interfaces")), self.on_interfaces)
        in_thread(lambda: helper("get-password", root=True).strip(), self.on_password)
        in_thread(lambda: vendor("00:00:00:00:00:00"), lambda *_: None)  # load the maker list off the UI thread

    # ---- Devices page ------------------------------------------------------------------

    def build_devices(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12)
        bar = Gtk.Box(spacing=8)
        bar.pack_start(Gtk.Label(label="<b>Speed for everyone</b>", use_markup=True), False, False, 0)
        self.everyone = speed_combo()
        self.everyone.set_tooltip_text("Each device gets its own lane at this speed")
        self.everyone_handler = self.everyone.connect("changed", self.on_everyone)
        self.everyone_custom = None
        bar.pack_start(self.everyone, False, False, 0)
        self.search = Gtk.SearchEntry(placeholder_text="Search devices")
        self.search.connect("search-changed", lambda *_: self.device_filter.refilter())
        bar.pack_end(self.search, False, False, 0)
        box.pack_start(bar, False, False, 0)
        self.limits_label = Gtk.Label(xalign=0, wrap=True, use_markup=True)
        self.limits_label.get_style_context().add_class("dim-label")
        self.limits_label.connect("activate-link", self.on_reset_own_limits)
        box.pack_start(self.limits_label, False, False, 0)

        self.devices = Gtk.ListStore(str, str, str, str, str, float, str, str, float, str, bool, bool)
        self.device_filter = self.devices.filter_new()
        self.device_filter.set_visible_func(self.device_visible)
        self.device_view = Gtk.TreeView(model=Gtk.TreeModelSort(model=self.device_filter), enable_search=False,
                                        activate_on_single_click=True)
        self.device_view.connect("row-activated", self.on_device_clicked)
        for title, col, sort in (("", C_STATUS, C_ONLINE), ("Device", C_NAME, C_SORT_NAME),
                                 ("Using now", C_NOW, C_NOW_SORT), ("Speed limit", C_LIMIT, C_LIMIT),
                                 ("Data used", C_DATA, C_DATA_SORT)):
            column = Gtk.TreeViewColumn(title, Gtk.CellRendererText(ypad=4), markup=col)
            column.set_sort_column_id(sort)
            column.set_expand(col == C_NAME)
            self.device_view.append_column(column)
        self.device_view.get_model().set_sort_column_id(C_SORT_NAME, Gtk.SortType.ASCENDING)
        scroll = Gtk.ScrolledWindow(vexpand=True, shadow_type=Gtk.ShadowType.IN)
        scroll.add(self.device_view)
        box.pack_start(scroll, True, True, 0)

        footer = Gtk.Box(spacing=8)
        hint = Gtk.Label(label="Click a device to change its speed or name, or to block it.", xalign=0)
        hint.get_style_context().add_class("dim-label")
        footer.pack_start(hint, True, True, 0)
        self.show_offline = Gtk.CheckButton(label="Show offline devices")
        self.show_offline.connect("toggled", lambda *_: self.device_filter.refilter())
        footer.pack_end(self.show_offline, False, False, 0)
        box.pack_start(footer, False, False, 0)
        return box

    def fill_devices(self, devices):
        """Update the device list in place (keeps scroll position); return total live speed."""
        now = time.monotonic()
        rows = {row[C_MAC]: row.iter for row in self.devices}
        total_down = total_up = 0.0
        self.device_info = {d["mac"]: d for d in devices}
        esc = GLib.markup_escape_text
        for d in devices:
            mac, online = d["mac"], d["online"]
            down = up = 0.0
            if online:
                prev = self.prev_bytes.get(mac)
                if prev and now > prev[2]:
                    down = max(0, d["down_bytes"] - prev[0]) * 8 / (now - prev[2])
                    up = max(0, d["up_bytes"] - prev[1]) * 8 / (now - prev[2])
                self.prev_bytes[mac] = (d["down_bytes"], d["up_bytes"], now)
                total_down, total_up = total_down + down, total_up + up
            else:
                self.prev_bytes.pop(mac, None)
            name = device_name(d)
            sub = d["ip"] if online else f"offline · {ago(d['last_seen'])}"
            status = ("<span foreground='#e01b24'>⛔</span>" if d["blocked"] else
                      "<span foreground='#2ec27e'>●</span>" if online else "<span foreground='#888888'>○</span>")
            if d["limit"] is None:
                limit = f"{esc(fmt_speed(d['effective']))} <small>(everyone)</small>" \
                    if d["effective"]["down"] or d["effective"]["up"] else "No limit"
            else:
                limit = f"<b>{esc(fmt_speed(d['limit']))}</b>"
            values = [
                mac, status, f"<b>{esc(name)}</b>\n<small>{esc(sub)}</small>", name.lower(),
                f"↓ {fmt_rate(down)}\n↑ {fmt_rate(up)}" if online else "", down + up, limit,
                human_bytes(d["down_bytes"] + d["up_bytes"]) if online else "",
                float(d["down_bytes"] + d["up_bytes"]) if online else 0.0,
                " ".join([name, d["hostname"], d["ip"], d["static_ip"], mac, vendor(mac)]).lower(),
                online, d["blocked"],
            ]
            if mac in rows:
                self.devices.set_row(rows.pop(mac), values)
            else:
                self.devices.append(values)
        for it in rows.values():
            self.devices.remove(it)
        return total_down, total_up

    def device_visible(self, model, it, _data):
        if not (model[it][C_ONLINE] or model[it][C_BLOCKED] or self.show_offline.get_active()):
            return False
        words = self.search.get_text().lower().split()
        return all(w in model[it][C_SEARCH] for w in words)

    def fill_everyone(self, limits):
        """Show the shared speed in the dropdown without triggering a change."""
        self.everyone.handler_block(self.everyone_handler)
        current = preset_id(limits["default"])
        # A custom value gets its own row, so "Custom…" can always be picked to change it.
        custom_text = fmt_speed(limits["default"]) if current == "custom" else None
        if custom_text != self.everyone_custom:
            self.everyone_custom = custom_text
            self.everyone.remove_all()
            self.everyone.append("0", "No limit")
            for kbit in SPEED_PRESETS:
                self.everyone.append(str(kbit), fmt_limit(kbit))
            if custom_text:
                self.everyone.append("current", custom_text)
            self.everyone.append("custom", "Custom…")
        self.everyone.set_active_id("current" if current == "custom" else current)
        self.everyone.handler_unblock(self.everyone_handler)

        esc = GLib.markup_escape_text
        each = limits["default"]
        parts = ["Each device gets its own lane at this speed" if each["down"] or each["up"]
                 else "Devices aren't limited"]
        if limits["total"]["down"] or limits["total"]["up"]:
            parts.append(f"whole hotspot capped at {esc(fmt_speed(limits['total']))}")
        own = sum(d["limit"] is not None for d in self.device_info.values())
        if own:
            parts.append(f"{own} device{'s have their' if own != 1 else ' has its'} own speed "
                         f"(<a href='reset'>use this speed for {'them' if own != 1 else 'it'} too</a>)")
        self.limits_label.set_markup(" · ".join(parts) + ".")

    def on_everyone(self, combo):
        choice = combo.get_active_id()
        limits = self.status.get("limits")
        if not limits or choice in (None, "current"):
            return
        if choice == "custom":
            self.edit_everyone(limits)
            self.fill_everyone(limits)  # until the change shows up in the next status update
            return
        kbit = int(choice)
        self.set_devices({"default": {"down": kbit, "up": kbit}},
                         f"Every device now gets {fmt_limit(kbit)}." if kbit else "Devices are no longer limited.")

    def edit_everyone(self, limits):
        dialog, area = self.dialog("Speed for everyone")
        area.add(heading("Each device", "Every device gets its own lane at this speed."))
        each = LimitEditor(limits["default"])
        area.add(each)
        total = LimitEditor(limits["total"], burst=False)
        cap = Gtk.Expander(label="Cap for the whole hotspot", expanded=bool(limits["total"]["down"] or limits["total"]["up"]))
        cap_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_start=12, margin_top=6)
        note = Gtk.Label(label="All devices together share at most this much.", xalign=0)
        note.get_style_context().add_class("dim-label")
        cap_box.add(note)
        cap_box.add(total)
        cap.add(cap_box)
        area.add(cap)
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK:
            payload = {"default": each.get(), "total": total.get()}
            self.set_devices(payload, f"Every device now gets {fmt_speed(payload['default']).lower()}.")
        dialog.destroy()

    def on_reset_own_limits(self, *_):
        own = {mac: {"limit": None} for mac, d in self.device_info.items() if d["limit"] is not None}
        self.set_devices({"devices": own}, "All devices now use the speed for everyone.")
        return True

    def on_device_clicked(self, view, path, _column):
        mac = view.get_model()[path][C_MAC]
        if mac in self.device_info:
            self.edit_device(self.device_info[mac])

    def edit_device(self, d):
        """One window for everything about a device: name, speed, fixed IP, disconnect/block/forget."""
        everyone = self.status["limits"]["default"]
        dialog, area = self.dialog(device_name(d), "Save")
        if d["online"]:
            info = [f"Connected for {human_time(d['connected'])}", d["ip"], f"signal {d['signal']} dBm",
                    f"used {human_bytes(d['down_bytes'] + d['up_bytes'])}"]
        else:
            info = [f"Offline, last seen {ago(d['last_seen'])}", d["ip"]]
        info += [vendor(d["mac"]), d["mac"]]
        details = Gtk.Label(label=" · ".join(x for x in info if x), xalign=0, wrap=True, selectable=True)
        details.get_style_context().add_class("dim-label")
        area.add(details)

        name = Gtk.Entry(text=d["name"], max_length=40, activates_default=True,
                         placeholder_text=d["hostname"] or "e.g. Ahmed's phone")
        speed = speed_combo(everyone)
        start = d["limit"] or everyone
        editor = LimitEditor(start if start["down"] or start["up"] else {"down": 10000, "up": 5000})
        custom = Gtk.Revealer(child=editor)
        speed.connect("changed", lambda c: custom.set_reveal_child(c.get_active_id() == "custom"))
        speed.set_active_id(preset_id(d["limit"]))
        area.add(form([("Name", name), ("Speed", speed), (None, custom)]))

        fixed_ip = Gtk.Expander(label="Fixed IP address", expanded=bool(d["static_ip"]))
        auto = Gtk.RadioButton(label="Automatic")
        fixed = Gtk.RadioButton.new_with_label_from_widget(auto, "Always give it")
        ip = Gtk.Entry(text=d["static_ip"] or d["ip"], activates_default=True, sensitive=bool(d["static_ip"]))
        fixed.set_active(bool(d["static_ip"]))
        fixed.connect("toggled", lambda r: ip.set_sensitive(r.get_active()))
        ip_row = Gtk.Box(spacing=8, margin_start=12, margin_top=6)
        for w in (auto, fixed, ip):
            ip_row.pack_start(w, w is ip, w is ip, 0)
        fixed_ip.add(ip_row)
        area.add(fixed_ip)

        # Actions that happen right away, separate from Save/Cancel.
        actions = Gtk.Box(spacing=6, margin_top=6)
        for label, what, show in (("Disconnect", "kick", d["online"]),
                                  ("Unblock" if d["blocked"] else "Block", "unblock" if d["blocked"] else "block", True),
                                  ("Forget", "forget", not d["online"])):
            if show:
                b = Gtk.Button(label=label)
                if what == "block":
                    b.get_style_context().add_class("destructive-action")
                b.connect("clicked", lambda _b, w=what: (dialog.response(Gtk.ResponseType.CANCEL),
                                                         self.device_action(d, w)))
                actions.pack_start(b, False, False, 0)
        area.add(actions)

        dialog.show_all()
        custom.set_reveal_child(speed.get_active_id() == "custom")
        if dialog.run() == Gtk.ResponseType.OK:
            choice = speed.get_active_id()
            limit = None if choice == "default" else editor.get() if choice == "custom" else \
                {"down": int(choice), "up": int(choice)}
            change = {"name": name.get_text().strip(), "limit": limit,
                      "static_ip": ip.get_text().strip() if fixed.get_active() else ""}
            self.set_devices({"devices": {d["mac"]: change}}, f"Saved {change['name'] or device_name(d)}.")
        dialog.destroy()

    def device_action(self, d, what):
        name = device_name(d)
        if what == "forget":
            self.set_devices({"devices": {d["mac"]: None}}, f"Removed {name} from the list.")
            return
        done = {"kick": f"Disconnected {name}.", "unblock": f"Unblocked {name}.",
                "block": f"Blocked {name}. It can't reconnect until you unblock it."}
        self.action(lambda: helper(what, d["mac"], root=True), done[what])

    # ---- Settings page -----------------------------------------------------------------

    def build_settings(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=16)

        self.ssid = Gtk.Entry(max_length=32)
        self.pw = Gtk.Entry(visibility=False, max_length=63, placeholder_text="Loading…")
        self.pw.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
        self.pw.set_icon_tooltip_text(Gtk.EntryIconPosition.SECONDARY, "Show / hide password")
        self.pw.connect("icon-press", lambda e, *_: e.set_visibility(not e.get_visibility()))
        gen = Gtk.Button(label="Generate")
        gen.connect("clicked", self.on_generate)
        pwbox = Gtk.Box(spacing=6)
        pwbox.pack_start(self.pw, True, True, 0)
        pwbox.pack_start(gen, False, False, 0)
        self.band = Gtk.ComboBoxText()
        self.band.append("5", "5 GHz (faster)")
        self.band.append("2.4", "2.4 GHz (longer range, older devices)")
        self.band.connect("changed", self.on_band)
        self.boot = Gtk.CheckButton(label="Turn on automatically at startup")
        box.add(form([("Network name", self.ssid), ("Password", pwbox), ("Band", self.band), ("", self.boot)]))

        self.channel, self.width = Gtk.ComboBoxText(), Gtk.ComboBoxText()
        self.country = Gtk.Entry(max_length=2, width_chars=4, placeholder_text="auto",
                                 tooltip_text="Two-letter country code; sets which channels and power are legal")
        self.adapter = Gtk.ComboBoxText()
        self.max_clients = Gtk.SpinButton.new_with_range(0, 64, 1)
        self.hidden = Gtk.CheckButton(label="Hide network name")
        self.isolate = Gtk.CheckButton(label="Stop connected devices from seeing each other")

        self.gateway = Gtk.Entry(placeholder_text="10.42.0.1")
        self.gateway.connect("changed", self.on_network_changed)
        self.prefix = Gtk.ComboBoxText()
        for prefix in range(16, 30):
            self.prefix.append(str(prefix), f"{ipaddress.IPv4Network(f'0.0.0.0/{prefix}').netmask}   (/{prefix})")
        self.prefix.connect("changed", self.on_network_changed)
        self.dhcp_start, self.dhcp_end = Gtk.Entry(width_chars=15), Gtk.Entry(width_chars=15)
        range_box = Gtk.Box(spacing=6)
        range_box.pack_start(self.dhcp_start, True, True, 0)
        range_box.pack_start(Gtk.Label(label="to"), False, False, 0)
        range_box.pack_start(self.dhcp_end, True, True, 0)
        self.lease = Gtk.ComboBoxText()
        for hours, text in LEASE_TIMES:
            self.lease.append(str(hours), text)
        self.dns = Gtk.Entry(placeholder_text="Automatic", tooltip_text="Up to 3, separated by commas, e.g. 1.1.1.1, 8.8.8.8")
        log = Gtk.Button(label="View log…", halign=Gtk.Align.START)
        log.connect("clicked", self.on_log)

        advanced = Gtk.Expander(label="Advanced")
        advanced.add(form([
            (None, heading("Wi-Fi")), ("Channel", self.channel), ("Channel width", self.width),
            ("Country", self.country), ("Wi-Fi adapter", self.adapter), ("Max devices (0 = no limit)", self.max_clients),
            ("", self.hidden), ("", self.isolate),
            (None, heading("Network", "Devices get an address from the DHCP range, with the hotspot IP as their gateway.")),
            ("Hotspot IP (gateway)", self.gateway), ("Subnet mask", self.prefix), ("DHCP range", range_box),
            ("Lease time", self.lease), ("DNS servers", self.dns),
            (None, heading("Troubleshooting")), ("", log),
        ], margin=12))
        box.add(advanced)

        save = Gtk.Button(label="Save", halign=Gtk.Align.END)
        save.get_style_context().add_class("suggested-action")
        save.connect("clicked", self.on_save)
        box.add(save)
        scroll = Gtk.ScrolledWindow()
        scroll.add(box)
        return scroll

    def on_interfaces(self, ifaces, err):
        if err:
            self.notify(f"Could not list Wi-Fi adapters: {err}", error=True)
            ifaces = []
        for i in ifaces:
            notes = ["USB" if i["usb"] else "built-in", "/".join(f"{b} GHz" for b in i["bands"])]
            if i["uplink"]:
                notes.append("in use for internet")
            if not i["ap"]:
                notes.append("can't host")
            self.adapter.append(i["name"], f"{i['name']}  ({', '.join(n for n in notes if n)})")
        # Start polling only now, so the adapter list is filled before the settings are.
        self.poll()
        GLib.timeout_add_seconds(2, self.poll)

    def on_password(self, pw, err):
        if err:
            self.pw.set_placeholder_text("Could not read the password")
            return
        self.password = pw
        self.pw.set_text(pw)
        self.pw.set_placeholder_text("8–63 characters")

    def fill_settings(self, cfg, boot):
        self.settings_loaded = True
        self.ssid.set_text(cfg["ssid"])
        self.band.set_active_id(cfg["band"])
        self.on_band()
        self.channel.set_active_id(str(cfg["channel"]))
        self.width.set_active_id(str(cfg["width"]))
        self.country.set_text(cfg["country"])
        if not self.adapter.set_active_id(cfg["interface"]) and cfg["interface"]:
            self.adapter.append(cfg["interface"], f"{cfg['interface']}  (not plugged in)")
            self.adapter.set_active_id(cfg["interface"])
        self.max_clients.set_value(cfg["max_clients"])
        self.hidden.set_active(cfg["hidden"])
        self.isolate.set_active(cfg["isolate"])
        self.boot.set_active(boot)
        self.gateway.set_text(cfg["gateway"])
        self.prefix.set_active_id(str(cfg["prefix"]))
        self.dhcp_start.set_text(cfg["dhcp_start"])
        self.dhcp_end.set_text(cfg["dhcp_end"])
        if not self.lease.set_active_id(str(cfg["lease_hours"])):
            self.lease.append(str(cfg["lease_hours"]), f"{cfg['lease_hours']} hours")
            self.lease.set_active_id(str(cfg["lease_hours"]))
        self.dns.set_text(", ".join(cfg["dns"]))

    def on_network_changed(self, *_):
        """When the hotspot IP or mask moves to another subnet, move the DHCP range along with it."""
        try:
            gw = ipaddress.IPv4Address(self.gateway.get_text().strip())
            net = ipaddress.IPv4Interface(f"{gw}/{self.prefix.get_active_id()}").network
        except ValueError:
            return
        try:
            if all(ipaddress.IPv4Address(e.get_text().strip()) in net for e in (self.dhcp_start, self.dhcp_end)):
                return
        except ValueError:
            pass
        first, last = net.network_address + 1, net.broadcast_address - 1
        if gw < last:
            start, end = min(gw + (9 if net.num_addresses > 64 else 1), last), last
        else:
            start, end = first, gw - 1
        self.dhcp_start.set_text(str(start))
        self.dhcp_end.set_text(str(end))

    def on_band(self, *_):
        band = self.band.get_active_id() or "5"
        channel, width = self.channel.get_active_id(), self.width.get_active_id()
        self.channel.remove_all()
        for c in CHANNELS[band]:
            self.channel.append(str(c), str(c))
        if not self.channel.set_active_id(channel or ""):
            self.channel.set_active(0)
        self.width.remove_all()
        for w in WIDTHS[band]:
            self.width.append(str(w), f"{w} MHz" + ("  (fastest)" if w == max(WIDTHS[band]) else ""))
        if not self.width.set_active_id(width or ""):
            self.width.set_active_id(str(max(WIDTHS[band])))

    def on_generate(self, *_):
        alphabet = string.ascii_letters + string.digits
        self.pw.set_text("".join(secrets.choice(alphabet) for _ in range(12)))
        self.pw.set_visibility(True)

    def on_save(self, *_):
        pw = self.pw.get_text()
        if pw and not 8 <= len(pw) <= 63:
            self.notify("The password must be 8 to 63 characters.", error=True)
            return
        data = {
            "ssid": self.ssid.get_text(), "band": self.band.get_active_id() or "5",
            "channel": int(self.channel.get_active_id() or 0), "width": int(self.width.get_active_id() or 20),
            "country": self.country.get_text().strip().upper(), "interface": self.adapter.get_active_id() or "",
            "hidden": self.hidden.get_active(), "isolate": self.isolate.get_active(),
            "max_clients": int(self.max_clients.get_value()), "boot": self.boot.get_active(),
            "gateway": self.gateway.get_text().strip(), "prefix": int(self.prefix.get_active_id() or 24),
            "dhcp_start": self.dhcp_start.get_text().strip(), "dhcp_end": self.dhcp_end.get_text().strip(),
            "lease_hours": int(self.lease.get_active_id() or 12),
            "dns": self.dns.get_text().replace(",", " ").replace(";", " ").split(),
        }
        if pw:
            data["password"] = pw
        running = self.status.get("state") == "active"

        def saved():
            self.password = pw or self.password
        self.action(lambda: helper("set-config", root=True, data=json.dumps(data)),
                    "Saved. The hotspot restarted with the new settings." if running else "Saved.", saved)

    def on_log(self, *_):
        dialog = Gtk.Dialog(title="Hotspot log", transient_for=self, modal=True)
        dialog.set_default_size(760, 460)
        dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        view = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        scroll = Gtk.ScrolledWindow(vexpand=True, shadow_type=Gtk.ShadowType.IN, margin=12)
        scroll.add(view)
        dialog.get_content_area().pack_start(scroll, True, True, 0)
        in_thread(lambda: helper("logs"), lambda text, err: view.get_buffer().set_text(err or text))
        dialog.show_all()
        dialog.run()
        dialog.destroy()

    # ---- status ------------------------------------------------------------------------

    def notify(self, text, error=False):
        self.info_label.set_text(text)
        self.infobar.set_message_type(Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO)
        self.infobar.set_revealed(True)

    def set_state_text(self, state, summary):
        self.state_label.set_markup(f"<span size='x-large' weight='bold'>{GLib.markup_escape_text(state)}</span>")
        self.summary_label.set_text(summary)

    def poll(self):
        if not self.polling:
            self.polling = True
            in_thread(lambda: json.loads(helper("status")), self.on_status)
        return True

    def on_status(self, st, err):
        self.polling = False
        if err:
            self.set_state_text("Hotspot status unavailable", err)
            return
        self.status = st
        cfg, state = st["config"], st["state"]
        if not self.busy:
            self.switch.handler_block(self.switch_handler)
            self.switch.set_active(state in ("active", "activating"))
            self.switch.handler_unblock(self.switch_handler)
        down, up = self.fill_devices(st["devices"])
        if state == "active":
            n = sum(d["online"] for d in st["devices"])
            summary = (f"{cfg['ssid']}  ·  {cfg['band']} GHz  ·  {n} device{'s' if n != 1 else ''} connected"
                       f"  ·  using ↓ {fmt_rate(down)}  ↑ {fmt_rate(up)}")
        elif state == "failed":
            summary = st["error"]
        else:
            summary = f"{cfg['ssid']}  ·  {cfg['band']} GHz"
        self.set_state_text(f"Hotspot {STATE_TEXT.get(state, state)}", summary)
        if not self.busy:
            self.fill_everyone(st["limits"])
        if not self.settings_loaded:
            self.fill_settings(cfg, st["boot"])

    # ---- actions -----------------------------------------------------------------------

    def action(self, work, ok_text, on_ok=None):
        self.busy = True

        def done(_res, err):
            self.busy = False
            if err:
                self.notify(err, error=True)
            else:
                if on_ok:
                    on_ok()
                self.notify(ok_text)
            self.poll()
        in_thread(work, done)

    def set_devices(self, payload, ok_text):
        self.action(lambda: helper("set-devices", root=True, data=json.dumps(payload)), ok_text)

    def dialog(self, title, ok_label="Apply"):
        d = Gtk.Dialog(title=title, transient_for=self, modal=True)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, ok_label, Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        d.get_widget_for_response(Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
        area = d.get_content_area()
        area.set_spacing(10)
        area.set_border_width(16)
        return d, area

    def on_switch(self, *_):
        on = self.switch.get_active()
        self.set_state_text("Starting…" if on else "Stopping…", "")
        self.action(lambda: helper("start" if on else "stop", root=True),
                    "Hotspot is on." if on else "Hotspot is off.")

    def on_share(self, *_):
        cfg = self.status.get("config", {})
        ssid, pw = cfg.get("ssid", ""), self.password or ""
        dialog = Gtk.Dialog(title="Join the hotspot", transient_for=self, modal=True)
        dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        area = dialog.get_content_area()
        area.set_spacing(10)
        area.set_border_width(16)
        if shutil.which("qrencode") and ssid and pw:
            png = subprocess.run(["qrencode", "-t", "PNG", "-s", "8", "-m", "2", "-o", "-",
                                  wifi_qr_text(ssid, pw, cfg.get("hidden"))], capture_output=True).stdout
            loader = GdkPixbuf.PixbufLoader.new_with_type("png")
            loader.write(png)
            loader.close()
            area.add(Gtk.Image.new_from_pixbuf(loader.get_pixbuf()))
            area.add(Gtk.Label(label="Scan with a phone camera to connect"))
        info = Gtk.Label(selectable=True)
        info.set_markup(f"Name: <b>{GLib.markup_escape_text(ssid)}</b>\nPassword: <b>{GLib.markup_escape_text(pw)}</b>")
        area.add(info)
        dialog.show_all()
        dialog.run()
        dialog.destroy()


class HotspotApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.xsobhi.HotspotManager")

    def do_activate(self):
        win = self.get_active_window() or HotspotWindow(self)
        win.show_all()
        win.present()


if __name__ == "__main__":
    HotspotApp().run()
