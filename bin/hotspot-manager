#!/usr/bin/python3
"""Hotspot Manager - control a hostapd Wi-Fi hotspot from the desktop."""
import json
import secrets
import shutil
import string
import subprocess
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, GLib, Gtk  # noqa: E402

HELPER = "/usr/local/bin/hotspotctl"
CHANNELS = {"5": [36, 40, 44, 48, 149, 153, 157, 161, 165], "2.4": list(range(1, 14))}
WIDTHS = {"5": [20, 40, 80], "2.4": [20, 40]}
OUI_FILE = "/usr/share/ieee-data/oui.txt"
# Device list columns
(C_MAC, C_STATUS, C_NAME, C_SORT_NAME, C_IP, C_NOW, C_NOW_SORT, C_LIMIT, C_SIGNAL, C_SIGNAL_SORT,
 C_DATA, C_DATA_SORT, C_SEEN, C_SEEN_SORT, C_SEARCH, C_ONLINE, C_BLOCKED) = range(17)
STATE_TEXT = {"active": "On", "activating": "Starting…", "deactivating": "Stopping…",
              "inactive": "Off", "failed": "Failed"}


def helper(*args, root=False, data=None):
    cmd = (["pkexec", HELPER] if root else [HELPER]) + list(args)
    p = subprocess.run(cmd, input=data, capture_output=True, text=True)
    if p.returncode != 0:
        msg = (p.stderr or p.stdout).strip() or f"{args[0]} failed"
        raise RuntimeError(msg.removeprefix("hotspotctl: "))
    return p.stdout


def in_thread(work, done):
    """Run work() off the UI thread, then done(result, error) back on it."""
    def target():
        try:
            res, err = work(), None
        except Exception as e:  # shown to the user in the info bar
            res, err = None, str(e)
        GLib.idle_add(lambda: done(res, err) and False)
    threading.Thread(target=target, daemon=True).start()


def human_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def human_time(s):
    h, m = divmod(s // 60, 60)
    return f"{h}h {m}m" if h else f"{m}m {s % 60}s"


def fmt_rate(bits_per_sec):
    if bits_per_sec < 1000:
        return "0"
    if bits_per_sec < 1_000_000:
        return f"{bits_per_sec / 1000:.0f} kbps"
    return f"{bits_per_sec / 1_000_000:.1f} Mbps"


def fmt_limit(kbit):
    if not kbit:
        return "no limit"
    return f"{kbit} kbps" if kbit < 1000 else f"{kbit / 1000:g} Mbps"


def fmt_pair(limit):
    if not limit["down"] and not limit["up"]:
        return "no limit"
    return f"↓ {fmt_limit(limit['down'])}  ↑ {fmt_limit(limit['up'])}"


def ago(ts):
    if not ts:
        return "never"
    s = max(0, int(time.time()) - ts)
    for unit, n in (("day", 86400), ("h", 3600), ("min", 60)):
        if s >= n:
            v = s // n
            return f"{v} {unit}{'s' if unit == 'day' and v > 1 else ''} ago"
    return "just now"


_vendors = None


def vendor(mac):
    """Manufacturer from the MAC prefix; phones often use a random ("private") address instead."""
    global _vendors
    if int(mac[1], 16) & 2:
        return "private address"
    if _vendors is None:
        _vendors = {}
        try:
            with open(OUI_FILE, encoding="utf-8", errors="replace") as f:
                for line in f:
                    if "(hex)" in line:
                        prefix, _, name = line.partition("(hex)")
                        _vendors[prefix.strip().replace("-", ":").lower()] = name.strip()
        except OSError:
            pass
    return _vendors.get(mac[:8], "")


def device_name(d):
    return d["name"] or d["hostname"] or (vendor(d["mac"]) if vendor(d["mac"]) != "private address" else "") or "Unknown device"


def speed_spin(kbit):
    spin = Gtk.SpinButton.new_with_range(0, 1000, 0.5)
    spin.set_digits(1)
    spin.set_value(kbit / 1000)
    return spin


def spin_kbit(spin):
    return int(round(spin.get_value() * 1000))


def wifi_qr_text(ssid, password, hidden):
    esc = lambda s: "".join("\\" + c if c in '\\;,":' else c for c in s)
    return f"WIFI:T:WPA;S:{esc(ssid)};P:{esc(password)};{'H:true;' if hidden else ''};"


class HotspotWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Hotspot Manager")
        self.set_default_size(680, 560)
        self.set_icon_name("network-wireless-hotspot")
        self.status = {}
        self.password = None
        self.settings_loaded = False
        self.busy = False
        self.polling = False
        self.device_info = {}
        self.prev_bytes = {}

        header = Gtk.HeaderBar(show_close_button=True, title="Hotspot Manager")
        self.set_titlebar(header)
        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER, tooltip_text="Turn the hotspot on or off")
        self.switch_handler = self.switch.connect("notify::active", self.on_switch)
        header.pack_end(self.switch)
        share = Gtk.Button(label="Share", tooltip_text="Show the name, password and a QR code to join")
        share.connect("clicked", self.on_share)
        header.pack_start(share)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(box)
        self.infobar = Gtk.InfoBar(show_close_button=True, revealed=False)
        self.info_label = Gtk.Label(wrap=True, xalign=0)
        self.infobar.get_content_area().add(self.info_label)
        self.infobar.connect("response", lambda bar, _r: bar.set_revealed(False))
        box.pack_start(self.infobar, False, False, 0)

        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=16)
        self.state_label = Gtk.Label(xalign=0)
        self.summary_label = Gtk.Label(xalign=0, wrap=True, selectable=True)
        self.summary_label.get_style_context().add_class("dim-label")
        top.add(self.state_label)
        top.add(self.summary_label)
        box.pack_start(top, False, False, 0)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        box.pack_start(Gtk.StackSwitcher(stack=self.stack, halign=Gtk.Align.CENTER), False, False, 0)
        box.pack_start(self.stack, True, True, 0)
        self.stack.add_titled(self.build_devices(), "devices", "Devices")
        self.stack.add_titled(self.build_settings(), "settings", "Settings")
        self.stack.add_titled(self.build_log(), "log", "Log")
        self.stack.connect("notify::visible-child-name", self.on_page)

        self.set_state_text("Loading…", "")
        in_thread(lambda: json.loads(helper("interfaces")), self.on_interfaces)
        in_thread(lambda: helper("get-password", root=True).strip(), self.on_password)
        in_thread(lambda: vendor("00:00:00:00:00:00"), lambda *_: None)  # load the maker list off the UI thread

    # ---- pages -------------------------------------------------------------------------

    def build_devices(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12)
        bar = Gtk.Box(spacing=8)
        self.search = Gtk.SearchEntry(placeholder_text="Search by name, IP, MAC or maker")
        self.search.connect("search-changed", lambda *_: self.device_filter.refilter())
        bar.pack_start(self.search, True, True, 0)
        self.show_offline = Gtk.CheckButton(label="Show offline", tooltip_text="Also list devices that connected before")
        self.show_offline.connect("toggled", lambda *_: self.device_filter.refilter())
        bar.pack_start(self.show_offline, False, False, 0)
        limit_all = Gtk.Button(label="Limit all devices…")
        limit_all.connect("clicked", self.on_limit_all)
        bar.pack_start(limit_all, False, False, 0)
        box.pack_start(bar, False, False, 0)
        self.limits_label = Gtk.Label(xalign=0, wrap=True)
        self.limits_label.get_style_context().add_class("dim-label")
        box.pack_start(self.limits_label, False, False, 0)

        self.devices = Gtk.ListStore(str, str, str, str, str, str, float, str, str, int,
                                     str, float, str, int, str, bool, bool)
        self.device_filter = self.devices.filter_new()
        self.device_filter.set_visible_func(self.device_visible)
        self.device_view = Gtk.TreeView(model=Gtk.TreeModelSort(model=self.device_filter), enable_search=False)
        self.device_view.get_selection().set_mode(Gtk.SelectionMode.MULTIPLE)
        self.device_view.get_selection().connect("changed", self.on_selection)
        self.device_view.connect("row-activated", lambda *_: self.on_set_limit())
        for title, col, sort in (("", C_STATUS, C_ONLINE), ("Device", C_NAME, C_SORT_NAME), ("IP", C_IP, C_IP),
                                 ("Using now", C_NOW, C_NOW_SORT), ("Speed limit", C_LIMIT, C_LIMIT),
                                 ("Signal", C_SIGNAL, C_SIGNAL_SORT), ("Data used", C_DATA, C_DATA_SORT),
                                 ("Connected", C_SEEN, C_SEEN_SORT)):
            column = Gtk.TreeViewColumn(title, Gtk.CellRendererText(), markup=col)
            column.set_sort_column_id(sort)
            column.set_resizable(True)
            self.device_view.append_column(column)
        self.device_view.get_model().set_sort_column_id(C_SORT_NAME, Gtk.SortType.ASCENDING)
        scroll = Gtk.ScrolledWindow(vexpand=True, shadow_type=Gtk.ShadowType.IN)
        scroll.add(self.device_view)
        box.pack_start(scroll, True, True, 0)

        buttons = Gtk.Box(spacing=6)
        self.device_buttons = {}
        for label, handler, tip in (
                ("Set speed limit…", lambda *_: self.on_set_limit(), "Limit download/upload speed (or double-click a device)"),
                ("Rename…", self.on_rename, "Give the device a name you'll recognise"),
                ("Disconnect", lambda *_: self.on_device_action("kick"), "Kick the device off (it can reconnect)"),
                ("Block", lambda *_: self.on_device_action("block"), "Kick the device off and stop it from reconnecting"),
                ("Forget", self.on_forget, "Remove an offline device from the list, with its name and limit")):
            b = Gtk.Button(label=label, tooltip_text=tip, sensitive=False)
            b.connect("clicked", handler)
            buttons.pack_start(b, False, False, 0)
            self.device_buttons[label] = b
        box.pack_start(buttons, False, False, 0)
        return box

    def build_settings(self):
        grid = Gtk.Grid(column_spacing=12, row_spacing=10, margin=16)
        rows = []

        self.ssid = Gtk.Entry(max_length=32)
        rows.append(("Network name", self.ssid))

        self.pw = Gtk.Entry(visibility=False, max_length=63, placeholder_text="Loading…")
        self.pw.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
        self.pw.set_icon_tooltip_text(Gtk.EntryIconPosition.SECONDARY, "Show / hide password")
        self.pw.connect("icon-press", lambda e, *_: e.set_visibility(not e.get_visibility()))
        gen = Gtk.Button(label="Generate")
        gen.connect("clicked", self.on_generate)
        pwbox = Gtk.Box(spacing=6)
        pwbox.pack_start(self.pw, True, True, 0)
        pwbox.pack_start(gen, False, False, 0)
        rows.append(("Password", pwbox))

        self.band = Gtk.ComboBoxText()
        self.band.append("5", "5 GHz (faster)")
        self.band.append("2.4", "2.4 GHz (longer range, older devices)")
        self.band.connect("changed", self.on_band)
        rows.append(("Band", self.band))
        self.channel = Gtk.ComboBoxText()
        rows.append(("Channel", self.channel))
        self.width = Gtk.ComboBoxText()
        rows.append(("Channel width", self.width))
        self.country = Gtk.Entry(max_length=2, width_chars=4, placeholder_text="auto",
                                 tooltip_text="Two-letter country code; sets which channels and power are legal")
        rows.append(("Country", self.country))
        self.adapter = Gtk.ComboBoxText()
        rows.append(("Wi-Fi adapter", self.adapter))
        self.max_clients = Gtk.SpinButton.new_with_range(0, 64, 1)
        self.max_clients.set_tooltip_text("0 = no limit")
        rows.append(("Max devices (0 = no limit)", self.max_clients))
        self.hidden = Gtk.CheckButton(label="Hide network name")
        self.isolate = Gtk.CheckButton(label="Stop connected devices from seeing each other")
        self.boot = Gtk.CheckButton(label="Turn on automatically at startup")
        rows += [("", self.hidden), ("", self.isolate), ("", self.boot)]

        for n, (label, widget) in enumerate(rows):
            grid.attach(Gtk.Label(label=label, xalign=1), 0, n, 1, 1)
            widget.set_hexpand(True)
            grid.attach(widget, 1, n, 1, 1)
        save = Gtk.Button(label="Save and apply", halign=Gtk.Align.END)
        save.get_style_context().add_class("suggested-action")
        save.connect("clicked", self.on_save)
        grid.attach(save, 1, len(rows), 1, 1)

        scroll = Gtk.ScrolledWindow()
        scroll.add(grid)
        return scroll

    def build_log(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=12)
        self.log_view = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        scroll = Gtk.ScrolledWindow(vexpand=True, shadow_type=Gtk.ShadowType.IN)
        scroll.add(self.log_view)
        box.pack_start(scroll, True, True, 0)
        refresh = Gtk.Button(label="Refresh", halign=Gtk.Align.END)
        refresh.connect("clicked", lambda *_: self.load_log())
        box.pack_start(refresh, False, False, 0)
        return box

    # ---- status ------------------------------------------------------------------------

    def notify(self, text, error=False):
        self.info_label.set_text(text)
        self.infobar.set_message_type(Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO)
        self.infobar.set_revealed(True)

    def set_state_text(self, state, summary):
        self.state_label.set_markup(f"<span size='x-large' weight='bold'>{GLib.markup_escape_text(state)}</span>")
        self.summary_label.set_text(summary)

    def poll(self):
        if not self.polling:
            self.polling = True
            in_thread(lambda: json.loads(helper("status")), self.on_status)
        return True

    def on_status(self, st, err):
        self.polling = False
        if err:
            self.set_state_text("Hotspot status unavailable", err)
            return
        self.status = st
        cfg, link, state = st["config"], st["link"], st["state"]
        if not self.busy:
            self.switch.handler_block(self.switch_handler)
            self.switch.set_active(state in ("active", "activating"))
            self.switch.handler_unblock(self.switch_handler)
        down, up = self.fill_devices(st["devices"])
        if state == "active":
            n = sum(d["online"] for d in st["devices"])
            summary = (f"{cfg['ssid']}  ·  {cfg['band']} GHz  ·  channel {link.get('channel', cfg['channel'])}"
                       f"  ·  {link.get('width', cfg['width'])} MHz  ·  {n} device{'s' if n != 1 else ''} connected"
                       f"  ·  using ↓ {fmt_rate(down)}  ↑ {fmt_rate(up)}")
        elif state == "failed":
            summary = st["error"]
        else:
            summary = f"{cfg['ssid']}  ·  {cfg['band']} GHz"
        self.set_state_text(f"Hotspot {STATE_TEXT.get(state, state)}", summary)
        lim = st["limits"]
        self.limits_label.set_text(f"Each device: {fmt_pair(lim['default'])}    ·    "
                                   f"Whole hotspot: {fmt_pair(lim['total'])}")
        if not self.settings_loaded:
            self.fill_settings(cfg, st["boot"])

    def fill_devices(self, devices):
        """Update the device list in place (keeps selection and scroll); return total live speed."""
        now = time.monotonic()
        rows = {row[C_MAC]: row.iter for row in self.devices}
        total_down = total_up = 0.0
        self.device_info = {d["mac"]: d for d in devices}
        for d in devices:
            mac, online = d["mac"], d["online"]
            down = up = 0.0
            if online:
                prev = self.prev_bytes.get(mac)
                if prev and now > prev[2]:
                    down = max(0, d["down_bytes"] - prev[0]) * 8 / (now - prev[2])
                    up = max(0, d["up_bytes"] - prev[1]) * 8 / (now - prev[2])
                self.prev_bytes[mac] = (d["down_bytes"], d["up_bytes"], now)
                total_down, total_up = total_down + down, total_up + up
            else:
                self.prev_bytes.pop(mac, None)
            name, maker = device_name(d), vendor(mac)
            details = [x for x in (d["hostname"] if d["name"] else "", maker if maker != name else "", mac) if x]
            esc = GLib.markup_escape_text
            if d["blocked"]:
                status = "<span foreground='#e01b24'>⛔</span>"
            elif online:
                status = "<span foreground='#2ec27e'>●</span>"
            else:
                status = "<span foreground='#888888'>○</span>"
            eff, own = d["effective"], d["limit"] is not None
            limit = fmt_pair(eff)
            if eff["down"] or eff["up"]:
                limit = f"<b>{limit}</b>" if own else f"{limit}  <small>(all devices)</small>"
            values = [
                mac, status, f"<b>{esc(name)}</b>\n<small>{esc('  ·  '.join(details))}</small>", name.lower(),
                d["ip"], f"↓ {fmt_rate(down)}\n↑ {fmt_rate(up)}" if online else "", down + up, limit,
                f"{d['signal']} dBm" if online and d.get("signal") else "", int(d.get("signal") or -999) if online else -999,
                f"↓ {human_bytes(d['down_bytes'])}\n↑ {human_bytes(d['up_bytes'])}" if online else "",
                float(d["down_bytes"] + d["up_bytes"]) if online else 0.0,
                human_time(d["connected"]) if online else ago(d["last_seen"]),
                -d["connected"] if online else d["last_seen"] - int(time.time()),
                " ".join([name, d["hostname"], d["ip"], mac, maker]).lower(), online, d["blocked"],
            ]
            if mac in rows:
                self.devices.set_row(rows.pop(mac), values)
            else:
                self.devices.append(values)
        for it in rows.values():
            self.devices.remove(it)
        self.on_selection()
        return total_down, total_up

    def device_visible(self, model, it, _data):
        if not (model[it][C_ONLINE] or model[it][C_BLOCKED] or self.show_offline.get_active()):
            return False
        words = self.search.get_text().lower().split()
        return all(w in model[it][C_SEARCH] for w in words)

    def selected(self):
        model, paths = self.device_view.get_selection().get_selected_rows()
        return [self.device_info[model[p][C_MAC]] for p in paths if model[p][C_MAC] in self.device_info]

    def on_selection(self, *_):
        sel = self.selected()
        b = self.device_buttons
        b["Set speed limit…"].set_sensitive(bool(sel))
        b["Rename…"].set_sensitive(len(sel) == 1)
        b["Disconnect"].set_sensitive(any(d["online"] for d in sel))
        b["Block"].set_sensitive(bool(sel))
        b["Block"].set_label("Unblock" if sel and all(d["blocked"] for d in sel) else "Block")
        b["Forget"].set_sensitive(bool(sel) and not any(d["online"] for d in sel))

    # ---- settings ----------------------------------------------------------------------

    def on_interfaces(self, ifaces, err):
        if err:
            self.notify(f"Could not list Wi-Fi adapters: {err}", error=True)
            ifaces = []
        for i in ifaces:
            notes = ["USB" if i["usb"] else "built-in", i["driver"], "/".join(f"{b} GHz" for b in i["bands"])]
            if i["uplink"]:
                notes.append("in use for internet")
            if not i["ap"]:
                notes.append("can't host")
            self.adapter.append(i["name"], f"{i['name']}  ({', '.join(n for n in notes if n)})")
        # Start polling only now, so the adapter list is filled before the settings are.
        self.poll()
        GLib.timeout_add_seconds(2, self.poll)

    def on_password(self, pw, err):
        if err:
            self.pw.set_placeholder_text("Could not read the password")
            return
        self.password = pw
        self.pw.set_text(pw)
        self.pw.set_placeholder_text("8–63 characters")

    def fill_settings(self, cfg, boot):
        self.settings_loaded = True
        self.ssid.set_text(cfg["ssid"])
        self.band.set_active_id(cfg["band"])
        self.on_band()
        self.channel.set_active_id(str(cfg["channel"]))
        self.width.set_active_id(str(cfg["width"]))
        self.country.set_text(cfg["country"])
        if not self.adapter.set_active_id(cfg["interface"]) and cfg["interface"]:
            self.adapter.append(cfg["interface"], f"{cfg['interface']}  (not plugged in)")
            self.adapter.set_active_id(cfg["interface"])
        self.max_clients.set_value(cfg["max_clients"])
        self.hidden.set_active(cfg["hidden"])
        self.isolate.set_active(cfg["isolate"])
        self.boot.set_active(boot)

    def on_band(self, *_):
        band = self.band.get_active_id() or "5"
        channel, width = self.channel.get_active_id(), self.width.get_active_id()
        self.channel.remove_all()
        for c in CHANNELS[band]:
            self.channel.append(str(c), str(c))
        if not self.channel.set_active_id(channel or ""):
            self.channel.set_active(0)
        self.width.remove_all()
        for w in WIDTHS[band]:
            self.width.append(str(w), f"{w} MHz" + ("  (fastest)" if w == max(WIDTHS[band]) else ""))
        if not self.width.set_active_id(width or ""):
            self.width.set_active_id(str(max(WIDTHS[band])))

    def on_generate(self, *_):
        alphabet = string.ascii_letters + string.digits
        self.pw.set_text("".join(secrets.choice(alphabet) for _ in range(12)))
        self.pw.set_visibility(True)

    def on_save(self, *_):
        pw = self.pw.get_text()
        if pw and not 8 <= len(pw) <= 63:
            self.notify("The password must be 8 to 63 characters.", error=True)
            return
        data = {
            "ssid": self.ssid.get_text(), "band": self.band.get_active_id() or "5",
            "channel": int(self.channel.get_active_id() or 0), "width": int(self.width.get_active_id() or 20),
            "country": self.country.get_text().strip().upper(), "interface": self.adapter.get_active_id() or "",
            "hidden": self.hidden.get_active(), "isolate": self.isolate.get_active(),
            "max_clients": int(self.max_clients.get_value()), "boot": self.boot.get_active(),
        }
        if pw:
            data["password"] = pw
        running = self.status.get("state") == "active"

        def saved():
            self.password = pw or self.password
        self.action(lambda: helper("set-config", root=True, data=json.dumps(data)),
                    "Saved. The hotspot restarted with the new settings." if running else "Saved.", saved)

    # ---- actions -----------------------------------------------------------------------

    def action(self, work, ok_text, on_ok=None):
        self.busy = True

        def done(_res, err):
            self.busy = False
            if err:
                self.notify(err, error=True)
            else:
                if on_ok:
                    on_ok()
                self.notify(ok_text)
            self.poll()
        in_thread(work, done)

    def on_switch(self, *_):
        on = self.switch.get_active()
        self.set_state_text("Starting…" if on else "Stopping…", "")
        self.action(lambda: helper("start" if on else "stop", root=True),
                    "Hotspot is on." if on else "Hotspot is off.")

    def on_device_action(self, what):
        sel = self.selected()
        if what == "block" and sel and all(d["blocked"] for d in sel):
            what = "unblock"
        if what == "kick":
            sel = [d for d in sel if d["online"]]
        if not sel:
            return
        names = device_name(sel[0]) if len(sel) == 1 else f"{len(sel)} devices"
        done = {"kick": f"Disconnected {names}.", "unblock": f"Unblocked {names}.",
                "block": f"Blocked {names}. They can't reconnect until you unblock them."}
        macs = [d["mac"] for d in sel]
        self.action(lambda: [helper(what, m, root=True) for m in macs], done[what])

    def set_devices(self, payload, ok_text):
        self.action(lambda: helper("set-devices", root=True, data=json.dumps(payload)), ok_text)

    def dialog(self, title, ok_label="Apply"):
        d = Gtk.Dialog(title=title, transient_for=self, modal=True)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, ok_label, Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.OK)
        d.get_widget_for_response(Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
        area = d.get_content_area()
        area.set_spacing(10)
        area.set_border_width(16)
        return d, area

    @staticmethod
    def speed_grid(down_spin, up_spin):
        grid = Gtk.Grid(column_spacing=8, row_spacing=6, margin_start=24)
        for row, (label, spin) in enumerate((("Download", down_spin), ("Upload", up_spin))):
            grid.attach(Gtk.Label(label=label, xalign=1), 0, row, 1, 1)
            grid.attach(spin, 1, row, 1, 1)
            grid.attach(Gtk.Label(label="Mbps   (0 = no limit)", xalign=0), 2, row, 1, 1)
        return grid

    def on_set_limit(self):
        sel = self.selected()
        if not sel:
            return
        default = self.status["limits"]["default"]
        own = sel[0]["limit"] if len(sel) == 1 else None
        title = device_name(sel[0]) if len(sel) == 1 else f"{len(sel)} devices"
        dialog, area = self.dialog(f"Speed limit: {title}")
        r_default = Gtk.RadioButton(label=f"Same as all devices ({fmt_pair(default)})")
        r_none = Gtk.RadioButton.new_with_label_from_widget(r_default, "No limit")
        r_custom = Gtk.RadioButton.new_with_label_from_widget(r_default, "Custom limit:")
        start = own or (default if default["down"] or default["up"] else {"down": 10000, "up": 5000})
        down_spin, up_spin = speed_spin(start["down"]), speed_spin(start["up"])
        grid = self.speed_grid(down_spin, up_spin)
        presets = Gtk.Box(spacing=4, margin_start=24)
        presets.pack_start(Gtk.Label(label="Quick:"), False, False, 0)
        for mbps in (1, 2, 5, 10, 20, 50):
            b = Gtk.Button(label=f"{mbps} Mbps")
            b.connect("clicked", lambda _b, v=mbps: (r_custom.set_active(True), down_spin.set_value(v), up_spin.set_value(v)))
            presets.pack_start(b, False, False, 0)
        for w in (r_default, r_none, r_custom, grid, presets):
            area.add(w)
        r_custom.connect("toggled", lambda r: grid.set_sensitive(r.get_active()))
        if own is None:
            r_default.set_active(True)
        elif not own["down"] and not own["up"]:
            r_none.set_active(True)
        else:
            r_custom.set_active(True)
        grid.set_sensitive(r_custom.get_active())
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK:
            if r_default.get_active():
                limit = None
            elif r_none.get_active():
                limit = {"down": 0, "up": 0}
            else:
                limit = {"down": spin_kbit(down_spin), "up": spin_kbit(up_spin)}
            self.set_devices({"devices": {d["mac"]: {"limit": limit} for d in sel}},
                             f"Speed limit for {title}: {fmt_pair(limit or default)}.")
        dialog.destroy()

    def on_limit_all(self, *_):
        lim = self.status.get("limits") or {k: {"down": 0, "up": 0} for k in ("default", "total")}
        dialog, area = self.dialog("Limit all devices")
        each = [speed_spin(lim["default"]["down"]), speed_spin(lim["default"]["up"])]
        total = [speed_spin(lim["total"]["down"]), speed_spin(lim["total"]["up"])]
        area.add(Gtk.Label(label="<b>Each device</b>\n<small>Every device gets at most this much, "
                                 "unless you gave it its own limit.</small>", use_markup=True, xalign=0))
        area.add(self.speed_grid(*each))
        area.add(Gtk.Label(label="<b>Whole hotspot</b>\n<small>All devices together share at most this much.</small>",
                           use_markup=True, xalign=0))
        area.add(self.speed_grid(*total))
        own = [mac for mac, d in self.device_info.items() if d["limit"] is not None]
        override = Gtk.CheckButton(label=f"Also replace the {len(own)} device-specific limit{'s' if len(own) != 1 else ''}")
        if own:
            area.add(override)
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK:
            payload = {"default": {"down": spin_kbit(each[0]), "up": spin_kbit(each[1])},
                       "total": {"down": spin_kbit(total[0]), "up": spin_kbit(total[1])}}
            if override.get_active():
                payload["devices"] = {mac: {"limit": None} for mac in own}
            self.set_devices(payload, f"Each device: {fmt_pair(payload['default'])}. "
                                      f"Whole hotspot: {fmt_pair(payload['total'])}.")
        dialog.destroy()

    def on_rename(self, *_):
        sel = self.selected()
        if len(sel) != 1:
            return
        d = sel[0]
        dialog, area = self.dialog("Rename device", "Save")
        area.add(Gtk.Label(label=f"MAC {d['mac']}" + (f"  ·  calls itself “{d['hostname']}”" if d["hostname"] else ""), xalign=0))
        entry = Gtk.Entry(text=d["name"], max_length=40, activates_default=True,
                          placeholder_text=d["hostname"] or "e.g. Ahmed's phone")
        area.add(entry)
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK:
            name = entry.get_text().strip()
            self.set_devices({"devices": {d["mac"]: {"name": name}}},
                             f"Renamed to {name}." if name else "Name cleared.")
        dialog.destroy()

    def on_forget(self, *_):
        sel = [d for d in self.selected() if not d["online"]]
        if sel:
            self.set_devices({"devices": {d["mac"]: None for d in sel}},
                             f"Forgot {device_name(sel[0]) if len(sel) == 1 else f'{len(sel)} devices'}.")

    def on_page(self, *_):
        if self.stack.get_visible_child_name() == "log":
            self.load_log()

    def load_log(self):
        in_thread(lambda: helper("logs"), lambda text, err: self.log_view.get_buffer().set_text(err or text))

    def on_share(self, *_):
        cfg = self.status.get("config", {})
        ssid, pw = cfg.get("ssid", ""), self.password or ""
        dialog = Gtk.Dialog(title="Join the hotspot", transient_for=self, modal=True)
        dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        area = dialog.get_content_area()
        area.set_spacing(10)
        area.set_border_width(16)
        if shutil.which("qrencode") and ssid and pw:
            png = subprocess.run(["qrencode", "-t", "PNG", "-s", "8", "-m", "2", "-o", "-",
                                  wifi_qr_text(ssid, pw, cfg.get("hidden"))], capture_output=True).stdout
            loader = GdkPixbuf.PixbufLoader.new_with_type("png")
            loader.write(png)
            loader.close()
            area.add(Gtk.Image.new_from_pixbuf(loader.get_pixbuf()))
            area.add(Gtk.Label(label="Scan with a phone camera to connect"))
        info = Gtk.Label(selectable=True)
        info.set_markup(f"Name: <b>{GLib.markup_escape_text(ssid)}</b>\nPassword: <b>{GLib.markup_escape_text(pw)}</b>")
        area.add(info)
        dialog.show_all()
        dialog.run()
        dialog.destroy()


class HotspotApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.xsobhi.HotspotManager")

    def do_activate(self):
        win = self.get_active_window() or HotspotWindow(self)
        win.show_all()
        win.present()


if __name__ == "__main__":
    HotspotApp().run()
